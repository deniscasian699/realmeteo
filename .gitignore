# ──────────────────────────────────────────
#  RealMeteo — .gitignore
# ──────────────────────────────────────────

# Android build outputs
*.apk
*.aab
*.dex
*.class

# Local Android properties
local.properties

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/.name
.idea/compiler.xml
.idea/copyright/
.idea/encodings.xml
.idea/misc.xml
.idea/vcs.xml
.idea/jsLibraryMappings.xml
.idea/datasources.xml
.idea/dataSources.ids
.idea/sqlDataSources.xml
.idea/dynamic.xml
.idea/uiDesigner.xml

# Gradle
.gradle/
build/
**/build/
gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Keystore / Signing (NEVER commit these)
*.jks
*.keystore
keystore.properties
signing.properties
release-keystore*

# Environment & secrets
*.env
.env.*
secrets.properties
google-services.json
google-services-staging.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Dependencies
node_modules/

# Temporary files
*.tmp
*.temp
*.swp
*.bak
*.orig

# Coverage reports
coverage/
*.lcov

# ProGuard
proguard/

# NDK
obj/
*.so

# CMake
.externalNativeBuild/
cmake-build-debug/
cmake-build-release/

# Captures (Android Studio profiler)
captures/
